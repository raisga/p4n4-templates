# ==============================================================================
# retail-vision: edge layer environment (in the store)
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ==============================================================================

# The store's time zone (the ingest service's STORE_TZ). Devices that write
# local times without an offset need the two to agree
TZ=UTC

# Compose profiles to start. "device" runs the uplink, once an edge device
# writes its database into DEVICE_DATA. The video service always runs
COMPOSE_PROFILES=

# ------------------------------------------------------------------------------
# Video (go2rtc, port 1984)
# ------------------------------------------------------------------------------
# The store camera: rtsp://user:password@ip:554/stream, or an http:// MJPEG
# stream. H.264 is transcoded to MJPEG for the dashboard; a camera substream
# (640x360) keeps that cheap. Empty: clips/floor.mp4 on a loop if it exists,
# else a synthetic test pattern
CAMERA_URL=
# The edge device's annotated view, as MJPEG, e.g. a Jetson's live mode at
# http://<device>:8777/mjpeg. Empty: clips/overlay.mp4 on a loop if it exists,
# else the test pattern with a moving tracked box
OVERLAY_URL=

# ------------------------------------------------------------------------------
# Uplink (profile "device") to the ingest service
# ------------------------------------------------------------------------------
# Where the device writes boutique_live.db (contract 0.1 tables: events,
# alerts, pos_transactions, zones). Relative to this directory
DEVICE_DATA=./data
# The device's own HTTP API, to report healthy rather than degraded in
# heartbeats (e.g. http://alpha:8080). Empty: healthy while the database is there
DEVICE_API=
# How many cameras the heartbeat reports
DEVICE_CAMERAS=1

# http://ingest:8080 when ../iot runs on this host; otherwise its HTTPS URL,
# e.g. https://stores.example.com (a reverse proxy in front of port 8090)
INGEST_URL=http://ingest:8080
# This store's id and token, as in the iot layer's .env (STORE_ID, STORE_TOKEN).
# STORE_ID replaces whatever store id the device writes; empty keeps it
STORE_ID=demo-store
STORE_TOKEN=demo-store-token
# Replaces the device's camera id; empty keeps it
CAMERA_ID=
# This device's name in heartbeats, Grafana and the agent
NODE_NAME=edge-01
# Reported in heartbeats as given, for a Jetson (`cat /etc/nv_tegra_release`, `sudo nvpmodel -q`)
JETPACK_VERSION=
POWER_MODE=
