      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"boutique_event\" and r._field == \"count\" and r.store_id == \"${store}\")\n  |> filter(fn: (r) => r.type =~ /^(customer_entry)$/ and r.role != \"staff\")\n  |> group()\n  |> sum()\n  |> rename(columns: {_value: \"Visitors\"})"
        }
