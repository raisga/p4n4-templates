    {
      "type": "bargauge",
      "title": "Funnel",
      "description": "From the door to the till, over the selected period.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "gridPos": {
        "x": 14,
        "y": 7,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "s0 = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"boutique_event\" and r._field == \"count\" and r.store_id == \"${store}\")\n  |> filter(fn: (r) => r.type =~ /^(customer_entry)$/ and r.role != \"staff\")\n  |> group()\n  |> sum()\n  |> map(fn: (r) => ({stage: \"Entries\", order: 0, _value: r._value}))\ns1 = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"boutique_event\" and r._field == \"count\" and r.store_id == \"${store}\")\n  |> filter(fn: (r) => r.type =~ /^(garment_touched|garment_taken)$/ and r.role != \"staff\")\n  |> group()\n  |> sum()\n  |> map(fn: (r) => ({stage: \"Interactions\", order: 1, _value: r._value}))\ns2 = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"boutique_event\" and r._field == \"count\" and r.store_id == \"${store}\")\n  |> filter(fn: (r) => r.type =~ /^(garment_taken)$/ and r.role != \"staff\")\n  |> group()\n  |> sum()\n  |> map(fn: (r) => ({stage: \"Took a garment\", order: 2, _value: r._value}))\ns3 = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"boutique_event\" and r._field == \"count\" and r.store_id == \"${store}\")\n  |> filter(fn: (r) => r.type =~ /^(fitting_room_entered)$/ and r.role != \"staff\")\n  |> group()\n  |> sum()\n  |> map(fn: (r) => ({stage: \"Fitting room\", order: 3, _value: r._value}))\ns4 = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"boutique_event\" and r._field == \"count\" and r.store_id == \"${store}\")\n  |> filter(fn: (r) => r.type =~ /^(checkout_visited)$/ and r.role != \"staff\")\n  |> group()\n  |> sum()\n  |> map(fn: (r) => ({stage: \"Till\", order: 4, _value: r._value}))\ns5 = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"boutique_sale\" and r.store_id == \"${store}\")\n  |> filter(fn: (r) => r._field == \"count\")\n  |> group()\n  |> sum()\n  |> map(fn: (r) => ({stage: \"Sales\", order: 5, _value: r._value}))\nunion(tables: [s0, s1, s2, s3, s4, s5])\n  |> group()\n  |> sort(columns: [\"order\"])\n  |> keep(columns: [\"stage\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987E5"
