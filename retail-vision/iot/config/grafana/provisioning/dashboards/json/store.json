        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"device\", predicate: (r) => r._measurement == \"boutique_node\" and r.store_id == \"${store}\", start: -30d)",
        "refresh": 2,
