    {
      "type": "stat",
      "title": "Edge device",
      "description": "Online: a heartbeat in the last 90 s with status healthy. No heartbeat for 90 s: no signal.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
