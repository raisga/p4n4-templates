    {
      "type": "barchart",
      "title": "Shelves: interest and sales",
      "description": "Garment interactions (camera) against units sold (till). High interest with few sales suggests checking sizes, price or display.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "interest = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"boutique_event\" and r._field == \"count\" and r.store_id == \"${store}\")\n  |> filter(fn: (r) => r.type =~ /^(garment_touched|garment_taken)$/ and r.role != \"staff\")\n  |> filter(fn: (r) => exists r.zone_id)\n  |> group(columns: [\"zone_id\"])\n  |> sum()\n  |> map(fn: (r) => ({shelf: r.zone_id, measure: \"Interactions\", _value: r._value}))\nsales = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"boutique_sale\" and r.store_id == \"${store}\")\n  |> filter(fn: (r) => r._field == \"count\")\n  |> group(columns: [\"shelf_id\"])\n  |> sum()\n  |> map(fn: (r) => ({shelf: r.shelf_id, measure: \"Units sold\", _value: r._value}))\nunion(tables: [interest, sales])\n  |> group()\n  |> pivot(rowKey: [\"shelf\"], columnKey: [\"measure\"], valueColumn: \"_value\")\n  |> sort(columns: [\"shelf\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
