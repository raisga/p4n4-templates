                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Units sold"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0CA30C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "shelf",
        "orientation": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10
    },
