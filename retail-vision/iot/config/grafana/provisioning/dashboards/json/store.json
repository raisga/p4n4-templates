            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1d)\n  |> filter(fn: (r) => r._measurement == \"boutique_node\" and r._field == \"up\" and r.device == \"${node}\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: if uint(v: now()) - uint(v: r._time) > uint(v: 90000000000) then 2 else 1 - r._value}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no signal",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "online",
                  "color": "#0CA30C",
                  "index": 0
                },
                "1": {
                  "text": "degraded",
                  "color": "#FAB219",
                  "index": 1
                },
                "2": {
                  "text": "no signal",
                  "color": "#D03B3B",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#545457",
                "value": null
              }
            ]
          }
        },
        "overrides": []
