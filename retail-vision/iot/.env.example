# ==============================================================================
# retail-vision: iot layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and tokens before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=UTC

# Compose profiles to start. "demo" runs the simulator: a synthetic store
# whose edge device and till post to the ingest service, with a week of
# history. Clear this once a real device is posting.
COMPOSE_PROFILES=demo

# ------------------------------------------------------------------------------
# Store
# ------------------------------------------------------------------------------
# The store's id, as its edge device sends it (the edge layer's uplink can
# rewrite whatever the device writes)
STORE_ID=demo-store
# Store time zone: an IANA name (America/Panama) or a UTC offset (-05:00).
# "Today", weekdays and peak hours follow it, and so do timestamps sent
# without an offset
STORE_TZ=UTC
# Language of the text the agent API answers with (rules, weekdays) and of
# the demo store's shelves and alerts: en or es. Regenerate the dashboard to
# match (scripts/build_dashboard.py --lang es) and set GRAFANA_LANGUAGE
STORE_LANG=en

# ------------------------------------------------------------------------------
# Ingest service (the web side of the device ↔ web contract 0.1)
# ------------------------------------------------------------------------------
# The store's write token: its edge device sends it as X-Store-Token. Generate one
# with `openssl rand -hex 24`. Empty: every write is refused
STORE_TOKEN=demo-store-token
# More stores, as store_id:token pairs, comma-separated
EXTRA_STORE_TOKENS=

# Token for reading (the agent API, alert reviews). The agent in ../ai needs
# the same value. Empty: anyone who reaches port 8090 can read every store
INGEST_READ_TOKEN=demo-read-token

# First level of the MQTT topics the ingest service publishes:
# <root>/<store>/event/<type>, …/alert/<type>, …/heartbeat, …/report, …/sale
MQTT_TOPIC_ROOT=retail

# The ingest service runs as this user, so ./data/ingest/ingest.db is yours.
# Set these to the output of `id -u` and `id -g`
DATA_UID=1000
DATA_GID=1000

# ------------------------------------------------------------------------------
# InfluxDB
# ------------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=ming
INFLUXDB_TOKEN=p4n4-stack-token

# Bucket for everything the ingest service copies (device health as
# sensor_data, plus boutique_event, boutique_alert, boutique_sale and
# boutique_node), created on first start
INFLUXDB_BUCKET=raw_telemetry
INFLUXDB_RETENTION=30d

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=adminpassword

# Grafana's interface language for new users, e.g. en-US, es-ES
GRAFANA_LANGUAGE=en-US

# true lets anyone who can reach port 3000 view dashboards without signing in
# (Viewer role: no editing). Use it for kiosk screens and p4n4-dashboard's
# normie view on a trusted network.
GRAFANA_ANONYMOUS=false

# true lets other sites show Grafana in a frame. p4n4-dashboard's web build
# needs it for its Grafana tab (native apps don't).
GRAFANA_ALLOW_EMBEDDING=false

# Path Grafana serves under. Set it to /grafana/ when p4n4-dashboard proxies
# Grafana on its own origin (its GRAFANA_UPSTREAM), e.g. for HTTPS.
GRAFANA_SUB_PATH=/

# ------------------------------------------------------------------------------
# Simulator (profile "demo")
# ------------------------------------------------------------------------------
# The demo till's currency
SIMULATOR_CURRENCY=USD
# Seconds between posts, and days of history posted on start
SIMULATOR_INTERVAL=15
SIMULATOR_BACKFILL_DAYS=7
