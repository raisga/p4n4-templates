# ==============================================================================
# retail-vision: ai layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Ollama (local LLM for p4n4-dashboard's Agent tab)
# ------------------------------------------------------------------------------
# Pulled on first start (about 4.6 GB; watch `docker compose logs -f ollama`).
# Any tag from https://ollama.com/library works, e.g. gemma4:e4b on a bigger
# machine. Changing it pulls the new model on the next start; remove an old one
# with `docker compose exec ollama ollama rm <model>`. Empty: pull nothing.
OLLAMA_MODEL=gemma4:e2b

# How long a model stays in memory after the last chat. Loading takes a while
# on a Raspberry Pi; 0 frees the memory right away, -1 keeps it loaded.
OLLAMA_KEEP_ALIVE=30m

# ------------------------------------------------------------------------------
# Agent (Ollama API with the store and InfluxDB tools, on port 11434)
# ------------------------------------------------------------------------------
# Whether thinking models (gemma4 is one) think before answering. true picks
# tools more reliably but takes several times longer, and the dashboard shows
# nothing while the model thinks. Empty: the model's default (on for gemma4).
AGENT_THINK=false

# ------------------------------------------------------------------------------
# InfluxDB, for the agent's tools (must match iot/.env)
# ------------------------------------------------------------------------------
# The agent only reads. The iot layer's admin token works; a read-only token
# for the bucket is safer: `docker compose exec influxdb influx auth create
# --read-bucket <bucket id> --org <org>` in iot/.
INFLUXDB_TOKEN=p4n4-stack-token
INFLUXDB_ORG=ming
INFLUXDB_BUCKET=raw_telemetry

# ------------------------------------------------------------------------------
# Ingest service, for the store tools (must match iot/.env)
# ------------------------------------------------------------------------------
INGEST_READ_TOKEN=demo-read-token
