# ==============================================================================
# mqtt-influx-grafana-ollama-pidurable: ai layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ==============================================================================

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# Ollama (local LLM)
# ------------------------------------------------------------------------------
# Pulled on first start (about 4.6 GB; watch `docker compose logs -f ollama`).
# The agent needs a model that calls tools. Empty: pull nothing.
OLLAMA_MODEL=gemma4:e2b
# How long a model stays in memory after the last request. Loading takes a
# while on a Raspberry Pi; 0 frees the memory right away, -1 keeps it loaded.
OLLAMA_KEEP_ALIVE=30m
# Context window Ollama gives every request, in tokens
OLLAMA_CONTEXT_LENGTH=8192

# ------------------------------------------------------------------------------
# Incident investigator (agent)
# ------------------------------------------------------------------------------
AGENT_IMAGE=ghcr.io/raisga/p4n4-agent:0.1.0
# Bearer token for the status API's investigation list, 32+ characters.
# Replace it: openssl rand -hex 32
AGENT_API_TOKEN=change-me-to-32-or-more-random-characters
# The model the agent reasons with: OLLAMA_MODEL, so Ollama keeps one in memory
AGENT_MODEL=gemma4:e2b
# Must not exceed OLLAMA_CONTEXT_LENGTH
AGENT_CONTEXT_TOKENS=8192
# One model request may take this long (a Raspberry Pi is slow to start one)
AGENT_MODEL_TIMEOUT_S=600
# SQLite synchronous mode. FULL: a commit survives a power cut (SD cards).
# NORMAL: survives a crash but may lose the last commit on power loss
AGENT_SQLITE_SYNC=FULL
# Alerts for one device within one window of this many seconds (aligned to the
# clock) are one investigation
AGENT_ALERT_WINDOW_S=900
# Tool calls per investigation, and how long one may take before it fails
AGENT_MAX_TOOL_CALLS=8
AGENT_INVESTIGATION_TIMEOUT_S=1800

# ------------------------------------------------------------------------------
# InfluxDB, for the agent's tools and results (must match iot/.env)
# ------------------------------------------------------------------------------
# The agent reads readings and inference results, and writes one
# agent_investigation point per finding.
INFLUXDB_TOKEN=p4n4-stack-token
INFLUXDB_ORG=ming
INFLUXDB_BUCKET=raw_telemetry
TZ=UTC
