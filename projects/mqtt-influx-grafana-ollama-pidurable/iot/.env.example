# ==============================================================================
# mqtt-influx-grafana-ollama-pidurable: iot layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and tokens before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=UTC

# Compose profiles to start. "demo" runs the simulated pumps, whose scripted
# bearing fault raises the first investigation a few minutes after start.
# Clear this once real devices are publishing.
COMPOSE_PROFILES=demo

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# InfluxDB
# ------------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=ming
INFLUXDB_TOKEN=p4n4-stack-token

# Bucket for readings, inference results and the agent's investigations,
# created on first start
INFLUXDB_BUCKET=raw_telemetry
INFLUXDB_RETENTION=30d

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=adminpassword

# true lets anyone who can reach port 3000 view dashboards without signing in
# (Viewer role: no editing)
GRAFANA_ANONYMOUS=false

# true lets other sites show Grafana in a frame. p4n4-dashboard's web build
# needs it for its Grafana tab (native apps don't).
GRAFANA_ALLOW_EMBEDDING=false

# ------------------------------------------------------------------------------
# Node-RED: ingest and the alert rule (editor on port 1880)
# ------------------------------------------------------------------------------
# Login for the editor and the Admin API. If NODE_RED_PASSWORD is empty,
# every login is refused.
NODE_RED_USER=admin
NODE_RED_PASSWORD=adminpassword

# An inference result above this anomaly_score publishes alerts/<device>/anomaly
ANOMALY_THRESHOLD=0.7
# Seconds between two alerts for one device while its score stays high. The
# agent merges alerts of one device and window anyway; this keeps MQTT quiet.
ALERT_HOLDOFF=60

# ------------------------------------------------------------------------------
# Simulator (profile "demo")
# ------------------------------------------------------------------------------
# One pump per name; they become the <device> in every topic
SIMULATOR_DEVICES=pump-1 pump-2
SIMULATOR_INTERVAL=5
# The pump whose bearing fails: its vibration and anomaly score rise
# SIMULATOR_FAULT_AFTER seconds after the simulator starts, for
# SIMULATOR_FAULT_DURATION seconds, and again every SIMULATOR_FAULT_EVERY
SIMULATOR_FAULT_DEVICE=pump-2
SIMULATOR_FAULT_AFTER=90
SIMULATOR_FAULT_DURATION=60
SIMULATOR_FAULT_EVERY=1800
