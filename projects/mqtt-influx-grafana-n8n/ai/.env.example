# ==============================================================================
# mqtt-influx-grafana-n8n: ai layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and secrets before production use!
# ==============================================================================

TZ=UTC

# "mailpit" starts a local inbox at http://localhost:8025 that catches every
# email n8n sends. Clear it once SMTP_* points at a real mail server.
COMPOSE_PROFILES=mailpit

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# n8n (http://localhost:5678)
# ------------------------------------------------------------------------------
# Owner login, applied on every start. n8n refuses to start without a password.
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=adminpassword

# Host name people reach n8n on. The acknowledge links in alert emails point
# here, so use the machine's LAN name or IP when alerts go to phones.
N8N_HOST=localhost

# Encrypts stored credentials. Set once, before the first start.
N8N_ENCRYPTION_KEY=change-me-32-char-encryption-key

# Workflows are imported on first start only, so edits made in n8n survive
# restarts. true overwrites them with the template's on the next start.
N8N_REIMPORT_WORKFLOWS=false

# ------------------------------------------------------------------------------
# Rules (seconds). Unit limits are in config/coldchain/units.json.
# ------------------------------------------------------------------------------
# How long a unit may be out of range (or silent) before the first alert:
# short blips, such as a door opened to load stock, are logged but not alerted
ALERT_DELAY=900
# How long an alert may go unacknowledged before it escalates
ESCALATE_AFTER=1800
# A unit with no reading for this long counts as an excursion (sensor offline)
OFFLINE_AFTER=600

# Signs the acknowledge links, so only links from an alert work. Any long
# random string: `openssl rand -hex 32`
ACK_SECRET=change-me-ack-secret

# ------------------------------------------------------------------------------
# Notifications
# ------------------------------------------------------------------------------
EMAIL_FROM=coldchain@example.com
# Comma-separated addresses: first alert, escalation, daily record
ALERT_EMAIL_TO=on-duty@example.com
ESCALATION_EMAIL_TO=manager@example.com
REPORT_EMAIL_TO=manager@example.com

# Mail server. The default is the local Mailpit inbox (profile "mailpit").
# Gmail, for example: smtp.gmail.com, 465, SMTP_SECURE=true, an app password.
SMTP_HOST=mailpit
SMTP_PORT=1025
# true: TLS from the start (port 465)
SMTP_SECURE=false
# false: never upgrade with STARTTLS (needed for Mailpit; true for port 587)
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=

# Optional extra channels, sent alongside the emails. Empty: off.
# Slack: an incoming webhook URL (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=
# Telegram: a bot token from @BotFather and the chat to post in
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# InfluxDB (must match iot/.env)
# ------------------------------------------------------------------------------
# n8n reads readings and writes the excursion log (coldchain_event,
# coldchain_status, coldchain_limit) into the same bucket.
INFLUXDB_TOKEN=p4n4-stack-token
INFLUXDB_ORG=ming
INFLUXDB_BUCKET=raw_telemetry
