{
  "uid": "p4n4-coldchain",
  "title": "Cold chain",
  "description": "Cold rooms on sensors/<unit>/temperature and …/door, and the excursions the n8n monitor detected, alerted, escalated and resolved.",
  "tags": [
    "p4n4",
    "mqtt-influx-grafana-n8n"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "unit",
        "label": "Unit",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-telemetry"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"device\", predicate: (r) => r._measurement == \"sensor_data\" and r.sensor == \"temperature\", start: -30d)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"device\", predicate: (r) => r._measurement == \"sensor_data\" and r.sensor == \"temperature\", start: -30d)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Units",
      "description": "Each unit's state as the n8n monitor last saw it (every minute).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 9,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"coldchain_status\" and r._field == \"state\" and r.device =~ /^${unit:regex}$/)\n  |> group(columns: [\"device\"])\n  |> last()\n  |> keep(columns: [\"_value\", \"device\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "ok": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "excursion": {
                  "text": "excursion",
                  "color": "yellow",
                  "index": 1
                },
                "offline": {
                  "text": "offline",
                  "color": "purple",
                  "index": 2
                },
                "alerted": {
                  "text": "alerted",
                  "color": "orange",
                  "index": 3
                },
                "escalated": {
                  "text": "escalated",
                  "color": "red",
                  "index": 4
                },
                "acknowledged": {
                  "text": "acknowledged",
                  "color": "blue",
                  "index": 5
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#8080804D"
          },
          "displayName": "${__field.labels.device}"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Temperature now",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 9,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.sensor == \"temperature\" and r._field == \"value\" and r.device =~ /^${unit:regex}$/)\n  |> group(columns: [\"device\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.device}"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Excursions",
      "description": "Excursions that started in the time range, alerted or not.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"coldchain_event\" and r.type == \"start\" and r._field == \"message\" and r.device =~ /^${unit:regex}$/)\n  |> group(columns: [\"device\"])\n  |> count()\n  |> keep(columns: [\"_value\", \"device\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "displayName": "${__field.labels.device}"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "$unit",
      "repeat": "unit",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "description": "Temperature, with the limits from units.json (dashed) as the n8n monitor applies them.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "temperature = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.sensor == \"temperature\" and r._field == \"value\" and r.device == \"${unit}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> set(key: \"series\", value: \"temperature\")\nlimits = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"coldchain_limit\" and r.device == \"${unit}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({r with series: r._field}))\nunion(tables: [temperature, limits])\n  |> group(columns: [\"series\"])\n  |> keep(columns: [\"_time\", \"_value\", \"series\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "displayName": "${__field.labels.series}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "stepAfter",
            "lineStyle": {
              "fill": "dash",
              "dash": [
                8,
                6
              ]
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "temperature"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "solid"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 8
              },
              {
                "id": "custom.lineInterpolation",
                "value": "linear"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Status",
      "description": "OK, excursion (not alerted yet), offline, alerted, escalated, acknowledged.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"coldchain_status\" and r._field == \"state\" and r.device =~ /^${unit:regex}$/)\n  |> group(columns: [\"device\"])\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "ok": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "excursion": {
                  "text": "excursion",
                  "color": "yellow",
                  "index": 1
                },
                "offline": {
                  "text": "offline",
                  "color": "purple",
                  "index": 2
                },
                "alerted": {
                  "text": "alerted",
                  "color": "orange",
                  "index": 3
                },
                "escalated": {
                  "text": "escalated",
                  "color": "red",
                  "index": 4
                },
                "acknowledged": {
                  "text": "acknowledged",
                  "color": "blue",
                  "index": 5
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#8080804D"
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "displayName": "${__field.labels.device}"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Doors",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.sensor == \"door\" and r._field == \"value\" and r.device =~ /^${unit:regex}$/)\n  |> group(columns: [\"device\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "#8080804D",
                  "index": 0
                },
                "1": {
                  "text": "open",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#8080804D"
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "displayName": "${__field.labels.device}"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Excursion log",
      "description": "Every decision the n8n monitor made, and every acknowledgement, newest first.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"coldchain_event\" and r.device =~ /^${unit:regex}$/)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 200)\n  |> map(fn: (r) => ({\"Time\": r._time, \"Unit\": r.device, \"Event\": r.type, \"Excursion since\": time(v: r.excursion), \"Details\": r.message, \"By\": if exists r.by then r.by else \"\", \"Corrective action\": if exists r.action then r.action else \"\"}))"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Event"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "start": {
                        "color": "yellow",
                        "index": 0
                      },
                      "alert": {
                        "color": "orange",
                        "index": 1
                      },
                      "escalate": {
                        "color": "red",
                        "index": 2
                      },
                      "ack": {
                        "text": "acknowledged",
                        "color": "blue",
                        "index": 3
                      },
                      "resolve": {
                        "text": "resolved",
                        "color": "green",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unit"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "Unit": 1,
              "Event": 2,
              "Excursion since": 3,
              "Details": 4,
              "By": 5,
              "Corrective action": 6
            }
          }
        }
      ]
    }
  ]
}
