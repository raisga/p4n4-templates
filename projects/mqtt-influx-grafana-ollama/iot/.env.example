# ==============================================================================
# mqtt-influx-grafana-ollama: iot layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and tokens before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=UTC

# Compose profiles to start. "demo" runs the simulator, which publishes fake
# sensor readings. Clear this once real devices are publishing.
COMPOSE_PROFILES=demo

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# MQTT bridge to an external broker (inbound only)
# ------------------------------------------------------------------------------
# Pulls topics from another broker into the local one, like a long-running
# `mosquitto_sub -h <host> -u <user> -P <password> -t <topic>`, so Telegraf
# ingests them with local readings. Nothing is published back. Leave
# MQTT_REMOTE_HOST empty to disable the bridge. Quote a password containing
# $ or # in single quotes.
MQTT_REMOTE_HOST=
# Default: 8883 with TLS, 1883 without
MQTT_REMOTE_PORT=
MQTT_REMOTE_USER=
MQTT_REMOTE_PASSWORD=
# Comma-separated topic filters, e.g. sensors/#,sensors/greenhouse-+/+
MQTT_REMOTE_TOPICS=sensors/#
# Prepended to bridged topics locally, e.g. remote/. Telegraf only reads
# sensors/..., so a prefix keeps bridged messages out of InfluxDB.
MQTT_REMOTE_PREFIX=
MQTT_REMOTE_QOS=0
# Default: p4n4-bridge-<container id>; set one if the broker restricts client IDs
MQTT_REMOTE_CLIENT_ID=
MQTT_REMOTE_TLS=false
# With TLS: a CA file in config/mosquitto/certs/ (empty: system CA bundle), and
# a client certificate and key there for brokers that require mutual TLS
MQTT_REMOTE_CA_FILE=
MQTT_REMOTE_CERT_FILE=
MQTT_REMOTE_KEY_FILE=

# ------------------------------------------------------------------------------
# InfluxDB
# ------------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=ming
INFLUXDB_TOKEN=p4n4-stack-token

# Bucket for all sensor readings, created on first start
INFLUXDB_BUCKET=raw_telemetry
INFLUXDB_RETENTION=30d

# ------------------------------------------------------------------------------
# File-system archive (./data/archive)
# ------------------------------------------------------------------------------
# Files rotate on this interval. How many rotated files are kept is set by
# rotation_max_archives in config/telegraf/telegraf.conf (default 30).
ARCHIVE_ROTATION_INTERVAL=24h

# Telegraf runs as this user so archive files are owned by you on the host.
# Set these to the output of `id -u` and `id -g`.
ARCHIVE_UID=1000
ARCHIVE_GID=1000

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=adminpassword

# true lets anyone who can reach port 3000 view dashboards without signing in
# (Viewer role: no editing). Use it for kiosk screens and p4n4-dashboard's
# normie view on a trusted network.
GRAFANA_ANONYMOUS=false

# true lets other sites show Grafana in a frame. p4n4-dashboard's web build
# needs it for its Grafana tab (native apps don't).
GRAFANA_ALLOW_EMBEDDING=false

# Path Grafana serves under. Set it to /grafana/ when p4n4-dashboard proxies
# Grafana on its own origin (its GRAFANA_UPSTREAM), e.g. for HTTPS. Grafana is
# then at http://<host>:3000/grafana/ directly too.
GRAFANA_SUB_PATH=/

# ------------------------------------------------------------------------------
# Simulator (profile "demo")
# ------------------------------------------------------------------------------
SIMULATOR_DEVICES=dev-01 dev-02
SIMULATOR_INTERVAL=5
