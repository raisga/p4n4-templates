          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1d)\n  |> filter(fn: (r) => r._measurement == \"alpr_node\" and r._field == \"up\" and r.device == \"${node}\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: if uint(v: now()) - uint(v: r._time) > uint(v: 90000000000) then 2 else 1 - r._value}))"
