    {
      "type": "stat",
      "title": "Vehicles",
      "description": "Every vehicle the cameras saw, plate read or not.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alpr_read\" and r._field == \"count\" and r.site_id == \"${site}\")\n  |> group()\n  |> aggregateWindow(every: 1h, fn: sum, createEmpty: true)\n  |> map(fn: (r) => ({_time: r._time, _value: if exists r._value then float(v: r._value) else 0.0}))\n  |> rename(columns: {_value: \"Vehicles\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
