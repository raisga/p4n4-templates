        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"site_id\", predicate: (r) => r._measurement == \"alpr_read\" or r._measurement == \"alpr_node\", start: -30d)",
