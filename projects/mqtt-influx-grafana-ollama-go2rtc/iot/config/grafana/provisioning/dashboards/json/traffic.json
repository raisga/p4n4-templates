    {
      "type": "stat",
      "title": "Read rate",
      "description": "Plates read / vehicles, over the period. Under 80% on a camera is worth checking.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alpr_read\" and r._field == \"count\" and r.site_id == \"${site}\")\n  |> map(fn: (r) => ({r with yes: if r.plate_read == \"yes\" then r._value else 0}))\n  |> group()\n  |> reduce(identity: {n: 0, yes: 0}, fn: (r, accumulator) => ({n: accumulator.n + r._value, yes: accumulator.yes + r.yes}))\n  |> map(fn: (r) => ({_value: if r.n > 0 then float(v: r.yes) / float(v: r.n) else 0.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
