# ==============================================================================
# mqtt-influx-grafana-ollama-go2rtc: iot layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and tokens before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=UTC

# Compose profiles to start. "demo" runs the simulator: a synthetic road
# whose ALPR device posts plate reads, with a week of history. Clear this once
# a real device is posting.
COMPOSE_PROFILES=demo

# ------------------------------------------------------------------------------
# Site
# ------------------------------------------------------------------------------
# The site's id, as its edge device sends it (the edge layer's uplink can
# rewrite whatever the device writes)
SITE_ID=demo-road
# Site time zone: an IANA name (America/Panama) or a UTC offset (-05:00).
# "Today", weekdays and peak hours follow it, and so do timestamps sent
# without an offset
SITE_TZ=UTC
# Language of the text the agent API answers with (checks, weekdays): en or
# es. Regenerate the dashboard to match (scripts/build_dashboard.py --lang es)
# and set GRAFANA_LANGUAGE
SITE_LANG=en
# The road's speed limit in km/h, if the device measures speed: summaries
# then count vehicles over it. Empty: no limit
SITE_SPEED_LIMIT=50

# ------------------------------------------------------------------------------
# Plates (personal data in many places: check the law where the cameras are)
# ------------------------------------------------------------------------------
# Days the ingest service keeps plate reads. Older ones are deleted every
# hour, and refused on arrival. Plates are kept only in ./data/ingest/ingest.db:
# InfluxDB, Grafana and MQTT get counts without them
RETENTION_DAYS=30
# true: MQTT messages carry the plate (topics never do). Mosquitto here allows
# anonymous clients, so set up its authentication first
MQTT_PLATES=false

# ------------------------------------------------------------------------------
# Ingest service (the web side of the ALPR device ↔ web contract 0.1)
# ------------------------------------------------------------------------------
# The site's write token: its edge device sends it as X-Site-Token. Generate
# one with `openssl rand -hex 24`. Empty: every write is refused
SITE_TOKEN=demo-site-token
# More sites, as site_id:token pairs, comma-separated
EXTRA_SITE_TOKENS=

# Token for reading (the agent API, plate lookups included). The agent in
# ../ai needs the same value. Empty: anyone who reaches port 8090 can look up
# plates
INGEST_READ_TOKEN=demo-read-token

# First level of the MQTT topics the ingest service publishes:
# <root>/<site>/read/<direction>, <root>/<site>/heartbeat
MQTT_TOPIC_ROOT=traffic

# The ingest service runs as this user, so ./data/ingest/ingest.db is yours.
# Set these to the output of `id -u` and `id -g`
DATA_UID=1000
DATA_GID=1000

# ------------------------------------------------------------------------------
# InfluxDB
# ------------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=ming
INFLUXDB_TOKEN=p4n4-stack-token

# Bucket for everything the ingest service copies (counts as alpr_read,
# device health as sensor_data and alpr_node; no plates), created on first start
INFLUXDB_BUCKET=raw_telemetry
INFLUXDB_RETENTION=30d

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=adminpassword

# Grafana's interface language for new users, e.g. en-US, es-ES
GRAFANA_LANGUAGE=en-US

# true lets anyone who can reach port 3000 view dashboards without signing in
# (Viewer role: no editing). Use it for kiosk screens and p4n4-dashboard's
# normie view on a trusted network.
GRAFANA_ANONYMOUS=false

# true lets other sites show Grafana in a frame. p4n4-dashboard's web build
# needs it for its Grafana tab (native apps don't).
GRAFANA_ALLOW_EMBEDDING=false

# Path Grafana serves under. Set it to /grafana/ when p4n4-dashboard proxies
# Grafana on its own origin (its GRAFANA_UPSTREAM), e.g. for HTTPS.
GRAFANA_SUB_PATH=/

# ------------------------------------------------------------------------------
# Simulator (profile "demo")
# ------------------------------------------------------------------------------
# Seconds between posts, and days of history posted on start
SIMULATOR_INTERVAL=15
SIMULATOR_BACKFILL_DAYS=7
