# ==============================================================================
# mqtt-influx-grafana-ollama-go2rtc: edge layer environment (at the site)
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ==============================================================================

# The site's time zone (the ingest service's SITE_TZ). Devices that write
# local times without an offset need the two to agree
TZ=UTC

# Compose profiles to start. "device" runs the uplink, once an ALPR device
# writes its database into DEVICE_DATA. The video service always runs
COMPOSE_PROFILES=

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# Video (go2rtc, port 1984)
# ------------------------------------------------------------------------------
# The road camera: rtsp://user:password@ip:554/stream, or an http:// MJPEG
# stream. H.264 is transcoded to MJPEG for the dashboard; a camera substream
# (640x360) keeps that cheap. Empty: clips/road.mp4 on a loop if it exists,
# else a synthetic test pattern
CAMERA_URL=
# The ALPR device's annotated view (vehicles and plates), as MJPEG, e.g.
# http://<device>:8777/mjpeg. Empty: clips/plates.mp4 on a loop if it exists,
# else the test pattern with a moving vehicle box
OVERLAY_URL=

# ------------------------------------------------------------------------------
# Uplink (profile "device") to the ingest service
# ------------------------------------------------------------------------------
# Where the device writes alpr_live.db (contract 0.1 table: reads). Relative
# to this directory
DEVICE_DATA=./data
# The device's own HTTP API, to report healthy rather than degraded in
# heartbeats (e.g. http://alpr:8080). Empty: healthy while the database is there
DEVICE_API=
# How many cameras the heartbeat reports
DEVICE_CAMERAS=2

# http://ingest:8080 when ../iot runs on this host; otherwise its HTTPS URL,
# e.g. https://traffic.example.com (a reverse proxy in front of port 8090).
# Plates travel in these requests: use HTTPS off the site's network
INGEST_URL=http://ingest:8080
# This site's id and token, as in the iot layer's .env (SITE_ID, SITE_TOKEN).
# SITE_ID replaces whatever site id the device writes; empty keeps it
SITE_ID=demo-road
SITE_TOKEN=demo-site-token
# This device's name in heartbeats, Grafana and the agent
NODE_NAME=edge-01
# Reported in heartbeats as given, for a Jetson (`cat /etc/nv_tegra_release`, `sudo nvpmodel -q`)
JETPACK_VERSION=
POWER_MODE=
