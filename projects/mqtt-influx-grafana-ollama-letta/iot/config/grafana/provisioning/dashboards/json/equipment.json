{
  "uid": "p4n4-equipment",
  "title": "Equipment health",
  "description": "Pumps and fans: vibration, bearing temperature and motor current on sensors/<machine>/<sensor>, with the maintenance the assistant logged.",
  "tags": [
    "p4n4",
    "mqtt-influx-grafana-ollama-letta"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-telemetry"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"device\", predicate: (r) => r._measurement == \"sensor_data\" and r.sensor == \"vibration\", start: -30d)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"device\", predicate: (r) => r._measurement == \"sensor_data\" and r.sensor == \"vibration\", start: -30d)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Maintenance",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-telemetry"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "refId": "Anno",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"maintenance_event\" and r._field == \"work\")\n  |> map(fn: (r) => ({_time: r._time, text: r.device + \": \" + r._value, tags: r.device}))"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Vibration now",
      "description": "Velocity RMS on the drive-end bearing. ISO 10816-3 zones: good up to 2.8 mm/s, acceptable up to 4.5, unsatisfactory up to 7.1, unacceptable above.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.sensor == \"vibration\" and r._field == \"value\" and r.device =~ /^${machine:regex}$/)\n  |> group(columns: [\"device\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2.8
              },
              {
                "color": "orange",
                "value": 4.5
              },
              {
                "color": "red",
                "value": 7.1
              }
            ]
          },
          "displayName": "${__field.labels.device}",
          "unit": "suffix: mm/s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bearing temperature now",
      "description": "Drive-end bearing temperature. Above 70 °C points to lubrication or bearing problems.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.sensor == \"bearing_temp\" and r._field == \"value\" and r.device =~ /^${machine:regex}$/)\n  |> group(columns: [\"device\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "displayName": "${__field.labels.device}",
          "unit": "celsius"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Last maintenance",
      "description": "The latest work logged per machine, by the assistant (log_maintenance).",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1y)\n  |> filter(fn: (r) => r._measurement == \"maintenance_event\" and r._field == \"work\" and r.device =~ /^${machine:regex}$/)\n  |> group(columns: [\"device\"])\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({\"Machine\": r.device, \"When\": r._time, \"Work\": r._value}))"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Machine"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "When"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Machine": 0,
              "When": 1,
              "Work": 2
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Vibration",
      "description": "Dashed lines: the ISO 10816-3 zone limits (2.8, 4.5, 7.1 mm/s). Markers: maintenance logged by the assistant.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.sensor == \"vibration\" and r._field == \"value\" and r.device =~ /^${machine:regex}$/)\n  |> group(columns: [\"device\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.device}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2.8
              },
              {
                "color": "orange",
                "value": 4.5
              },
              {
                "color": "red",
                "value": 7.1
              }
            ]
          },
          "unit": "suffix: mm/s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Bearing temperature",
      "description": "Dashed lines: 70 °C and 80 °C.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.sensor == \"bearing_temp\" and r._field == \"value\" and r.device =~ /^${machine:regex}$/)\n  |> group(columns: [\"device\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.device}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Motor current",
      "description": "Motor current. A slow rise alongside vibration means the machine is working harder.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.sensor == \"current\" and r._field == \"value\" and r.device =~ /^${machine:regex}$/)\n  |> group(columns: [\"device\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.device}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "amp"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Maintenance log",
      "description": "Work recorded through the assistant's log_maintenance tool, newest first. The assistant also keeps each entry in its memory.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1y)\n  |> filter(fn: (r) => r._measurement == \"maintenance_event\" and r.device =~ /^${machine:regex}$/)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 200)\n  |> map(fn: (r) => ({\"Time\": r._time, \"Machine\": r.device, \"Work\": r.work, \"Technician\": if exists r.technician then r.technician else \"\"}))"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Machine"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Technician"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "Machine": 1,
              "Work": 2,
              "Technician": 3
            }
          }
        }
      ]
    }
  ]
}
