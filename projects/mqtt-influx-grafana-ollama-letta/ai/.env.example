# ==============================================================================
# mqtt-influx-grafana-ollama-letta: ai layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change LETTA_SERVER_PASSWORD before production use!
# ==============================================================================

TZ=UTC

# ------------------------------------------------------------------------------
# Ollama (models for the agent)
# ------------------------------------------------------------------------------
# Pulled on first start (about 4.6 GB + 0.3 GB; watch `docker compose logs -f
# ollama`). The chat model must support tool calls. Any such tag from
# https://ollama.com/library works, e.g. gemma4:e4b or qwen3:8b on a bigger
# machine: a stronger model uses the agent's memory and tools more reliably.
# After a change, `docker compose up -d` pulls it and switches the agent.
OLLAMA_MODEL=gemma4:e2b
# Embeddings for the agent's archival memory. Changing it later breaks
# searches of the memories stored so far: set it once.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Context window, in tokens. Letta's prompt alone (instructions, memory
# blocks, tools) is about 6000; the agent is limited to this, and Letta
# summarizes older messages to stay inside it. More needs more memory.
OLLAMA_CONTEXT_LENGTH=16384

# How long a model stays in memory after the last chat; -1 keeps it loaded
OLLAMA_KEEP_ALIVE=30m

# Whether thinking models (gemma4 is one) reason before every step. false
# roughly halves answer times on a CPU: Letta takes several steps per answer
# (tool calls), and p4n4-api gives Letta 5 minutes. true can pick tools more
# reliably on a GPU.
AGENT_THINK=false

# Address Ollama's API is published on (127.0.0.1: this machine only)
OLLAMA_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# Letta (agents with memory)
# ------------------------------------------------------------------------------
# Every API call needs it. p4n4-api reads it from this file.
LETTA_SERVER_PASSWORD=lettapassword
# Address the Letta API is published on (127.0.0.1: this machine only)
LETTA_BIND=127.0.0.1

# Name of the agent letta-init creates. A new name creates a new agent with
# fresh memory; the old one stays until you delete it.
AGENT_NAME=maintenance-assistant

# ------------------------------------------------------------------------------
# InfluxDB, for the agent's tools (must match iot/.env)
# ------------------------------------------------------------------------------
# The tools read readings and write maintenance_event points.
INFLUXDB_TOKEN=p4n4-stack-token
INFLUXDB_ORG=ming
INFLUXDB_BUCKET=raw_telemetry
