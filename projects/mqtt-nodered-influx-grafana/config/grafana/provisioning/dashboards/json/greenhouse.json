{
  "uid": "p4n4-greenhouse",
  "title": "Greenhouse",
  "description": "Greenhouse zones: readings on sensors/<zone>/<measurement>, and the fan and valve commands Node-RED sends on actuators/<zone>/<actuator>/set, both stored in InfluxDB by Telegraf.",
  "tags": [
    "p4n4",
    "mqtt-nodered-influx-grafana"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "zone",
        "label": "Zone",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-telemetry"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"device\", predicate: (r) => r._measurement == \"sensor_data\", start: -30d)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"device\", predicate: (r) => r._measurement == \"sensor_data\", start: -30d)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Now",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 15,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => (r.sensor == \"temperature\" or r.sensor == \"humidity\" or r.sensor == \"soil_moisture\") and r.device =~ /^${zone:regex}$/)\n  |> group(columns: [\"device\", \"sensor\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"device\", \"sensor\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.device} · ${__field.labels.sensor}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*temperature.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(humidity|soil_moisture).*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Actuators",
      "description": "The state each device reports on sensors/<zone>/fan and sensors/<zone>/valve.",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => (r.sensor == \"fan\" or r.sensor == \"valve\") and r.device =~ /^${zone:regex}$/)\n  |> group(columns: [\"device\", \"sensor\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"device\", \"sensor\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "off",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "on",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#8080804D"
          },
          "displayName": "${__field.labels.device} · ${__field.labels.sensor}"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature",
      "description": "Dashed lines: the fan rule's default thresholds, off at 26 °C (TEMP_HIGH − TEMP_HYSTERESIS) and on at 28 °C (TEMP_HIGH). Edit them here if you change .env.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => (r.sensor == \"temperature\") and r.device =~ /^${zone:regex}$/)\n  |> group(columns: [\"device\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.device}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "blue",
                "value": 26
              },
              {
                "color": "red",
                "value": 28
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Soil moisture",
      "description": "Dashed lines: the valve rule's default thresholds, open at 30 % (SOIL_LOW) and close at 45 % (SOIL_HIGH). Edit them here if you change .env.",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => (r.sensor == \"soil_moisture\") and r.device =~ /^${zone:regex}$/)\n  |> group(columns: [\"device\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.device}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "blue",
                "value": 45
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Humidity",
      "description": "Relative humidity. No rule acts on it: add one in Node-RED.",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => (r.sensor == \"humidity\") and r.device =~ /^${zone:regex}$/)\n  |> group(columns: [\"device\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.device}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Fan and valve",
      "description": "When each actuator was on, as its device reported it.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => (r.sensor == \"fan\" or r.sensor == \"valve\") and r.device =~ /^${zone:regex}$/)\n  |> group(columns: [\"device\", \"sensor\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device\", \"sensor\"])"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "off",
                  "color": "#8080804D",
                  "index": 0
                },
                "1": {
                  "text": "on",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#8080804D"
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "displayName": "${__field.labels.device} · ${__field.labels.sensor}"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Control decisions",
      "description": "Commands Node-RED sent on actuators/<zone>/<actuator>/set, newest first, with the rule or override behind each one.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 17,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"actuator_command\" and r.device =~ /^${zone:regex}$/)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)\n  |> map(fn: (r) => ({\"Time\": r._time, \"Zone\": r.device, \"Actuator\": r.actuator, \"State\": if r.state == 1.0 then \"on\" else \"off\", \"Mode\": if exists r.mode then r.mode else \"\", \"Reason\": if exists r.reason then r.reason else \"\"}))"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "on": {
                        "color": "green",
                        "index": 0
                      },
                      "off": {
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mode"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "Zone": 1,
              "Actuator": 2,
              "State": 3,
              "Mode": 4,
              "Reason": 5
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Switch-ons",
      "description": "On commands per actuator in the time range.",
      "gridPos": {
        "x": 17,
        "y": 20,
        "w": 7,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"actuator_command\" and r._field == \"state\" and r.device =~ /^${zone:regex}$/)\n  |> filter(fn: (r) => r._value == 1.0)\n  |> group(columns: [\"device\", \"actuator\"])\n  |> count()\n  |> keep(columns: [\"_value\", \"device\", \"actuator\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "displayName": "${__field.labels.device} · ${__field.labels.actuator}"
        },
        "overrides": []
      }
    }
  ]
}
