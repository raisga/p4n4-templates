# ==============================================================================
# mqtt-influx-grafana-obd2: iot layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and tokens before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=UTC

# Compose profiles to start. "demo" runs gps-sim, a car lapping a route in
# Monaco. Clear this once the phone app publishes real GPS fixes (and clear
# the extras layer's too, for the simulated car).
COMPOSE_PROFILES=demo

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# Device logins (TCP and WebSocket). Empty password: anonymous demo access.
# Set both to require a login; generate passwords with `openssl rand -hex 32`.
# The phone app's MQTT settings need the same pair. The Docker-only listener
# stays anonymous for the stack's services (obd2 included).
MQTT_USER=
MQTT_PASSWORD=
# Optional read-only account, with a different username and its own password.
MQTT_READONLY_USER=
MQTT_READONLY_PASSWORD=

# ------------------------------------------------------------------------------
# InfluxDB
# ------------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=ming
INFLUXDB_TOKEN=p4n4-stack-token

# Bucket for everything Telegraf stores (sensor_data, dtc, vehicle_status),
# created on first start
INFLUXDB_BUCKET=raw_telemetry
INFLUXDB_RETENTION=30d

# ------------------------------------------------------------------------------
# File-system archive (./data/archive)
# ------------------------------------------------------------------------------
# Files rotate on this interval. How many rotated files are kept is set by
# rotation_max_archives in config/telegraf/telegraf.conf (default 30).
ARCHIVE_ROTATION_INTERVAL=24h

# Telegraf runs as this user so archive files are owned by you on the host.
# Set these to the output of `id -u` and `id -g`.
ARCHIVE_UID=1000
ARCHIVE_GID=1000

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=adminpassword

# true lets anyone who can reach port 3000 view dashboards without signing in
# (Viewer role: no editing). Use it for kiosk screens and p4n4-dashboard's
# normie view on a trusted network, e.g. the phone itself.
GRAFANA_ANONYMOUS=false

# true lets other sites show Grafana in a frame. p4n4-dashboard's web build
# needs it for its Grafana tab (native apps don't).
GRAFANA_ALLOW_EMBEDDING=false

# Path Grafana serves under. Set it to /grafana/ when p4n4-dashboard proxies
# Grafana on its own origin (its GRAFANA_UPSTREAM), e.g. for HTTPS. Grafana is
# then at http://<host>:3000/grafana/ directly too.
GRAFANA_SUB_PATH=/

# ------------------------------------------------------------------------------
# GPS simulator (profile "demo")
# ------------------------------------------------------------------------------
# Device id in the topic (sensors/<id>/gps): the phone app's and the obd2
# service's (OBD_DEVICE_ID in ../extras/.env), so one dashboard shows them both
GPS_DEVICE_ID=car
# Seconds between fixes, and the top speed in km/h (corners are slower)
GPS_INTERVAL=1
GPS_MAX_SPEED=50
# A closed route to lap instead of the built-in one around Monaco:
# "lon,lat[,alt] lon,lat[,alt] ..." (degrees, metres), the last point joining
# the first. Points 20-50 m apart on the roads look best
GPS_ROUTE=
