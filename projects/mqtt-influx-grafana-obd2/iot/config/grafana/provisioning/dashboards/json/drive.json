          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\" and r.sensor == \"speed\")\n  |> aggregateWindow(every: 10s, fn: mean, createEmpty: true)\n  |> fill(value: 0.0)\n  |> integral(unit: 1h)\n  |> keep(columns: [\"_value\"])"
