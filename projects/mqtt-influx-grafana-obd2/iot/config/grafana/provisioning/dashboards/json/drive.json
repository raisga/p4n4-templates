    {
      "id": 9,
      "type": "stat",
      "title": "Fuel used",
      "description": "An estimate over the time range, from the mass air flow (MAF): grams of air / 14.7 (the stoichiometric air-fuel ratio of petrol) / 737 g per litre of petrol. Petrol engines only, and only as good as the MAF sensor; cars without one show no data.",
      "gridPos": {
        "x": 4,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\" and r.sensor == \"maf\")\n  |> aggregateWindow(every: 10s, fn: mean, createEmpty: true)\n  |> fill(value: 0.0)\n  |> integral(unit: 1s)\n  |> map(fn: (r) => ({r with _value: r._value / 14.7 / 737.0}))\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "litre",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Average consumption",
      "description": "Fuel used / distance over the time range, once the car has gone 100 m. The same estimate as Fuel used.",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\" and (r.sensor == \"speed\" or r.sensor == \"maf\"))\n  |> aggregateWindow(every: 10s, fn: mean, createEmpty: true)\n  |> fill(value: 0.0)\n  |> integral(unit: 1s)\n  |> group()\n  |> pivot(rowKey: [\"_start\"], columnKey: [\"sensor\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({km: if exists r.speed then r.speed / 3600.0 else 0.0, litres: if exists r.maf then r.maf / 14.7 / 737.0 else 0.0}))\n  |> filter(fn: (r) => r.km > 0.1 and r.litres > 0.0)\n  |> map(fn: (r) => ({_value: r.litres / r.km * 100.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: L/100 km",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Check engine (MIL)",
      "description": "The check-engine light. obd2 reports the trouble codes and the light when they change, so no report in 30 days means they've stayed clear.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"dtc\" and r._field == \"mil\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: if r._value then 1 else 0}))\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Off",
                  "index": 0
                },
                "1": {
                  "text": "On",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "Off"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Vehicle",
      "description": "From obd2's status: Connected while the car answers; Ignition off when the adapter does but the car doesn't; No adapter when obd2 can't reach it (OBD_DEVICE, or the app's OBD relay); obd2 offline when the service is down.",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"vehicle_status\" and r.device == \"${device}\")\n  |> filter(fn: (r) => r._field == \"online\" or r._field == \"vehicle\" or r._field == \"adapter\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> last(column: \"_time\")\n  |> map(fn: (r) => ({r with _value: if not r.online then 0 else if r.vehicle then 3 else if r.adapter != \"\" then 2 else 1}))\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "obd2 offline",
                  "index": 0
                },
                "1": {
                  "text": "No adapter",
                  "index": 1
                },
                "2": {
                  "text": "Ignition off",
                  "index": 2
                },
                "3": {
                  "text": "Connected",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Adapter",
      "description": "The adapter's version and the OBD-II protocol the car speaks.",
      "gridPos": {
        "x": 20,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"vehicle_status\" and r.device == \"${device}\")\n  |> filter(fn: (r) => r._field == \"adapter\" or r._field == \"protocol\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> last(column: \"_time\")\n  |> map(fn: (r) => ({r with _value: if r.adapter == \"\" then \"none\" else if r.protocol == \"\" then r.adapter else r.adapter + \", \" + r.protocol}))\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Speed",
      "description": "The car's speed (OBD-II) and the phone's (GPS).",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.device == \"${device}\")\n  |> filter(fn: (r) => (r.sensor == \"speed\" and r._field == \"value\") or (r.sensor == \"gps\" and r._field == \"speed\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with source: if r.sensor == \"gps\" then \"GPS\" else \"OBD-II\"}))\n  |> group(columns: [\"source\"])\n  |> keep(columns: [\"_time\", \"_value\", \"source\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "velocitykmh",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.source}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "RPM",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\" and r.sensor == \"rpm\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "rotrpm",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "displayName": "rpm"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 16,
      "type": "geomap",
      "title": "Route",
      "description": "The phone's GPS fixes (sensors/<device>/gps) over the time range, and the latest one. The base map, OpenFreeMap's, is online.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 14,
        "h": 12
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.device == \"${device}\" and r.sensor == \"gps\")\n  |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\" or r._field == \"speed\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> keep(columns: [\"_time\", \"lat\", \"lon\", \"speed\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r.device == \"${device}\" and r.sensor == \"gps\")\n  |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\" or r._field == \"speed\" or r._field == \"heading\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"lat\", \"lon\", \"speed\", \"heading\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 15,
          "maxZoom": 17,
          "allLayers": true,
          "padding": 10
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true,
          "showMeasure": false,
          "showDebug": false
        },
        "basemap": {
          "type": "maplibre",
          "name": "Basemap",
          "config": {
            "url": "https://tiles.openfreemap.org/styles/liberty"
          }
        },
        "layers": [
          {
            "type": "route",
            "name": "Track",
            "config": {
              "style": {
                "color": {
                  "fixed": "#22D3EE"
                },
                "opacity": 0.9,
                "lineWidth": 4
              },
              "arrow": 0
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "tooltip": true
          },
          {
            "type": "markers",
            "name": "Car",
            "config": {
              "showLegend": false,
              "style": {
                "color": {
                  "fixed": "#F87171"
                },
                "opacity": 1,
                "size": {
                  "fixed": 9,
                  "min": 2,
                  "max": 15
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "B"
            },
            "tooltip": true
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Trouble codes",
      "description": "The latest reports of trouble codes, newest first: one when the codes or the check-engine light change. An empty row is the moment they cleared. obd2 only reads codes; it never clears them.",
      "gridPos": {
        "x": 14,
        "y": 18,
        "w": 10,
        "h": 12
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"dtc\" and r.device == \"${device}\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 20)\n  |> map(fn: (r) => ({\"Reported\": r._time, \"MIL\": if exists r.mil and r.mil then \"on\" else \"off\", \"Stored\": if exists r.codes then r.codes else \"\", \"Pending\": if exists r.pending then r.pending else \"\", \"Permanent\": if exists r.permanent then r.permanent else \"\", \"Descriptions\": if exists r.descriptions then r.descriptions else \"\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Reported"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MIL"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "on": {
                        "color": "red",
                        "index": 0
                      },
                      "off": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Reported": 0,
              "MIL": 1,
              "Stored": 2,
              "Pending": 3,
              "Permanent": 4,
              "Descriptions": 5
            }
          }
        }
      ]
    }
  ]
}
