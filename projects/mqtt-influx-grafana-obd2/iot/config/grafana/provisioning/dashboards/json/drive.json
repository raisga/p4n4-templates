{
  "uid": "p4n4-drive",
  "title": "Drive",
  "description": "The car: OBD-II readings, trouble codes and status from obd2 (extras layer), and the phone's GPS track, all over MQTT (sensors/<device>/..., alerts/<device>/dtc, status/<device>/online).",
  "tags": [
    "p4n4",
    "mqtt-influx-grafana-obd2"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Car",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-telemetry"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"device\", predicate: (r) => r._measurement == \"sensor_data\", start: -30d)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"device\", predicate: (r) => r._measurement == \"sensor_data\", start: -30d)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "car",
          "value": "car"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Speed",
