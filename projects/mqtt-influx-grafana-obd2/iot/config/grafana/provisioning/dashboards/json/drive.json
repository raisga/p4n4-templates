      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-telemetry"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\" and r.sensor == \"speed\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
