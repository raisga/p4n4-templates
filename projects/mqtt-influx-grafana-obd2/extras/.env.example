# ==============================================================================
# mqtt-influx-grafana-obd2: extras layer environment
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ==============================================================================

TZ=UTC

# Compose profiles to start. "demo" runs obd2-sim, a simulated car for obd2 to
# read. Clear it once obd2 reads a real car (OBD_DEVICE below). obd2 and tiles
# always run
COMPOSE_PROFILES=demo

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# OBD-II (obd2, API port 8090)
# ------------------------------------------------------------------------------
# The adapter: the simulator (profile "demo") by default. In the car, the phone
# app's OBD relay, which bridges the paired Bluetooth ELM327 to TCP 35100 on the
# phone:
#   OBD_DEVICE=socket://host.docker.internal:35100
# A Wi-Fi adapter: socket://<its address>:35000 (often 192.168.0.10)
OBD_DEVICE=socket://p4n4-obd2-sim:35000
# Device id in the topics (sensors/<id>/rpm, status/<id>/online): one topic
# level. The app's GPS fixes use the same one (sensors/car/gps)
OBD_DEVICE_ID=car
# Empty: detect them. The adapter's serial speed, and the OBD-II protocol
# (1-9, A-C; 6 is CAN 11-bit 500 kbit/s, what most cars since 2008 use)
OBD_BAUDRATE=
OBD_PROTOCOL=
# Reads per second of rpm, speed and MAF (fast) and of the rest (slow); seconds
# between battery voltage and trouble code reads
OBD_POLL_FAST_HZ=5
OBD_POLL_SLOW_HZ=1
OBD_VOLTAGE_INTERVAL=5
OBD_DTC_INTERVAL=30
# Only these measurements, comma-separated (empty: every one the car supports):
# rpm, speed, maf, engine_load, coolant_temp, stft_b1, ltft_b1, intake_temp,
# throttle_pos, fuel_level, battery_v
OBD_PIDS=
# Publish sensors/<id>/raw, a feature vector for an edge model. This template
# has none, and Telegraf drops the topic
OBD_RAW=false
# The broker: ../iot's Mosquitto on p4n4-net, whose Docker-only listener needs
# no login. MQTT_USER and MQTT_PASSWORD (../iot's) only for a listener that
# does, e.g. with network_mode: host (see README.md)
MQTT_HOST=p4n4-mqtt
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# Address and host port of the read-only API. Keep 127.0.0.1 unless the network is
# trusted (a car's hotspot isn't, by default)
OBD2_BIND=127.0.0.1
OBD2_PORT=8090
OBD2_LOG_LEVEL=INFO
# Simulator (profile "demo"): a scenario from obd2/simulator/scenarios/ (without
# .yaml), and close the connection every N seconds like a pulled adapter (0: never)
OBD_SIM_SCENARIO=warmup
OBD_SIM_DROP_EVERY=0

# ------------------------------------------------------------------------------
# Offline map (tiles)
# ------------------------------------------------------------------------------
# Host port of the map server: the app's Map tab loads
# http://<host>:8088/style.json. Fill ./data/map with scripts/fetch-map.sh
# first; while it's empty, the app shows an online map
MAP_PORT=8088
